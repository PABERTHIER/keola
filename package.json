    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "rolldown": "~1.2.11",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
