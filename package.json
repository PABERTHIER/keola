    "@nuxt/image": "^2.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.16",
    "@vue/composition-api": "^1.7.2",
    "lenis": "^1.3.26",
    "nuxt": "^4.5.2"
